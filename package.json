{
  "name": "conquest-exchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Conquest — the agent exchange. An exchange where autonomous agents are priced, listed and traded, and a swarm does the listing work.",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "conformance": "bun run scripts/conformance.ts",
    "engines:fetch": "bun run scripts/fetch-engines.ts",
    "recon": "bun run scripts/recon.ts",
    "determinism": "bun run scripts/determinism.ts",
    "zetaris:selftest": "bun run scripts/zetaris-selftest.ts",
    "llm:selftest": "bun run scripts/llm-selftest.ts",
    "avc:selftest": "bun run scripts/avc-selftest.ts",
    "listing:selftest": "bun run scripts/listing-selftest.ts",
    "serve": "bun run src/server.ts",
    "swarm": "bun run src/index.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "surrealdb.js": "^1.0.0"
  }
}
