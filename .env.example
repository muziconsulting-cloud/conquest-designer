# Copy to .env and fill in. NEVER commit .env or real keys.
# Leave SAMPLE_MODE=true to run fully offline with deterministic fallbacks.
SAMPLE_MODE=true

# Agent loop controls (bounded, predictable runs)
MAX_REVISIONS=2
CONFIDENCE_THRESHOLD=0.6

# ---------------------------------------------------------------------------
# Zetaris — federated query layer (required sponsor)
# ---------------------------------------------------------------------------
# Two shapes of the same API; set whichever applies.
# (a) REST API (official "secure API" reference + Postman collection):
#     POST <url>/api/v1/... with Authorization: Bearer <idToken>
#     headers: X-Org-ID: <numeric org id>, X-Request-ID: <uuid>
#     body for a SQL query:  { "select": "SELECT * FROM ...", "pageLimit": 2 }
#     pageLimit is 1..100.  Paging uses PageSqlQuery; always CloseSqlQuery
#     afterwards to release the server-side query.
# (b) API key / username+password against the same host.
# Blank = our own local data API is used by the adapter (same contract).
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ID_TOKEN=
ZETARIS_REFRESH_TOKEN=
ZETARIS_TARGET_ROLE=
ZETARIS_QUERY_TOKEN=

# ---------------------------------------------------------------------------
# Meterless — agent engines (required sponsor)
# ---------------------------------------------------------------------------
# (1) ENGINES — local-first, no account, no API key, no credit, no card.
#     Fetch the spec folder (AGENTS.md contract + conformance suite):
#       npx degit meterless/meterless/engines/<engine> <dest>
#     Conformance gates (exit 0 = green):
#       HMEM_IMPL=... bun vendor/meterless/<engine>/conformance/runner.ts
#       WORLD_MODEL_IMPL=... bun vendor/meterless/<engine>/conformance/runner.ts
METERLESS_ENGINES_DIR=./vendor/meterless

# (2) PROVIDER (Power layer) — the Meterless surface that serves models.
#     One credential of its own (organiser endpoint, still to be issued).
#     OpenAI-format chat/completions against METERLESS_BASE_URL.
#     NEMOTRON_MODEL is a PREFERENCE, not a requirement: the adapter asks the
#     provider which routing ids it exposes and picks the one that fits the role.
#     Leave it unset and the app works on the offline adapter.
METERLESS_BASE_URL=
METERLESS_API_KEY=
NEMOTRON_MODEL=

# (3) LOCAL RUNTIME — Meterless Runtime (Nightshift hotspot) on this machine.
#     OpenAI-compatible, default http://127.0.0.1:8088/v1
#     Model ids are routing modes: meterless/auto|fast|deep|cheap|local|fusion
#     Token is written by the runtime to <stateDir>/proxy-token.
METERLESS_RUNTIME_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_APP_ID=conquest-exchange
# Which model id the app asks for (provider or runtime). Falls back to a
# deterministic offline adapter when unset.
MODEL_ID=

# ---------------------------------------------------------------------------
# NVIDIA — Nemotron
# ---------------------------------------------------------------------------
# Nemotron is reached THROUGH Meterless, not through a direct NIM endpoint.
# We hold no NVIDIA account, no NVIDIA key and no NVIDIA billing — Nemotron
# is a model the Meterless fleet already serves. Pick the tier (Super / Nano /
# Ultra) via the routing id in NEMOTRON_MODEL above.

# ---------------------------------------------------------------------------
# AVC — the certificate's signing key (Ed25519)
# ---------------------------------------------------------------------------
# The certificate is signed. The key lives here and nowhere else — the code has
# NO default key and fails loudly when this is empty.
#   AVC_PRIVATE_KEY  the signing key: a JWK JSON string, or a raw 32-byte seed
#                    (base64url), or a PKCS8 blob (base64url).
#   AVC_PUBLIC_KEY   the verification key, published at
#                    /.well-known/avc-jwks.json: a raw 32-byte key (base64url),
#                    or a SPKI blob (base64url), or a JWK JSON string.
# Generate a pair:
#   bun -e 'const p=await crypto.subtle.generateKey({name:"Ed25519"},true,["sign","verify"]);const j=await crypto.subtle.exportKey("jwk",p.privateKey);const k=await crypto.subtle.exportKey("raw",p.publicKey);console.log(JSON.stringify(j));console.log(Buffer.from(k).toString("base64url"))'
AVC_PRIVATE_KEY=
AVC_PUBLIC_KEY=

# Optional: live SurrealDB target for the gated_intent ledger.
# When unset, the ledger appends to logs/ledger.jsonl instead.
SURREAL_URL=
SURREAL_NS=wardbyward
SURREAL_DB=wardbyward
SURREAL_USER=
SURREAL_PASS=
